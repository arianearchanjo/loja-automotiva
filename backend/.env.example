# ----------------------------------------------------------------------------
# Ambiente da aplicação
# ----------------------------------------------------------------------------
NODE_ENV="development"

# Porta em que o servidor Express escuta
PORT=3333

# ----------------------------------------------------------------------------
# Banco de dados PostgreSQL (utilizado pelo Prisma)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loja_automotiva"

# ----------------------------------------------------------------------------
# Better Auth
# ----------------------------------------------------------------------------
# Segredo usado para assinar sessões/tokens (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET="substitua-por-um-segredo-seguro-de-32-bytes-ou-mais"
# URL pública da aplicação (usada para callbacks de autenticação)
BETTER_AUTH_URL="http://localhost:3333"

# ----------------------------------------------------------------------------
# CORS (origem do front-end em desenvolvimento)
# ----------------------------------------------------------------------------
FRONTEND_URL="http://localhost:5173"
